<UserControl x:Class="NAGN.View.PropertiesAlgorithm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NAGN.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="Gray">
        <Expander Header="Properties" IsExpanded="True">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="White" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Name" />
                        <TextBox />
                        <CheckBox Content="Enabled"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1"
                        BorderBrush="White"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Input Image" />
                        <ComboBox>
                            <ComboBoxItem Content="a" />
                            <ComboBoxItem Content="a" />
                            <ComboBoxItem Content="a" />
                        </ComboBox>
                    </StackPanel>.
                </Border>
                <Border Grid.Row="2"
                        BorderBrush="White"
                        BorderThickness="0,0,0,1">

                </Border>
                <Border Grid.Row="3"
                        BorderBrush="White"
                        BorderThickness="0,0,0,1">

                </Border>
            </Grid>
        </Expander>
    </Grid>
</UserControl>
