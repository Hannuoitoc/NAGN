<UserControl x:Class="NAGN.View.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NAGN.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="Gray">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="1" BorderBrush="White" BorderThickness="0,1,1,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Background="White"
                            BorderBrush="#FFDDDDDD"
                            BorderThickness="1" Margin="1"
                            Click="Click_Open_Image"
                            ToolTip="Mở ảnh đầu vào">
                        <Image Source="\Assets\ImageIcon.png" />
                    </Button>
                    <Button ToolTip="Chụp ảnh (Camera)">
                        <Image Source="\Assets\istockphoto-1693405252-612x612.jpg" />
                    </Button>
                    <Button ToolTip="Live Video">
                        <Image Source="\Assets\istockphoto-1369198572-170667a.jpg" />
                    </Button>
                    <Button x:Name="RectangleRoi" Click="Click_RectangleRoi" ToolTip="Vẽ hình chữ nhật ROI">
                        <Image Source="\Assets\ImageRectangle.jpg" />
                    </Button>
                    <Button x:Name="PolygonRoi" Click="Click_PolygonRoi" ToolTip="Vẽ hình đa giác ROI (Click chọn điểm, Click đúp hoặc Chuột phải để hoàn tất)">
                        <Image Source="\Assets\polygon.png" />
                    </Button>
                </StackPanel>

                <!-- Bộ công cụ Zoom/Pan -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="5,0" VerticalAlignment="Center">
                    <Button Content="-" Width="28" Height="28" Margin="2,0" FontWeight="Bold" FontSize="15" Background="White" Click="BtnZoomOut_Click" ToolTip="Thu nhỏ (Zoom Out) - Hoặc lăn chuột xuống"/>
                    <Button Content="+" Width="28" Height="28" Margin="2,0" FontWeight="Bold" FontSize="15" Background="White" Click="BtnZoomIn_Click" ToolTip="Phóng to (Zoom In) - Hoặc lăn chuột lên"/>
                    <Button Content="1:1" Width="32" Height="28" Margin="2,0" FontSize="11" Background="White" Click="BtnZoomActual_Click" ToolTip="Kích thước thực 100%"/>
                    <Button Content="Fit" Width="32" Height="28" Margin="2,0" FontSize="11" FontWeight="Bold" Background="White" Click="BtnZoomFit_Click" ToolTip="Tự động vừa khung hình"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1"
                BorderBrush="White"
                BorderThickness="0,1,1,1"
                Background="#2B2B2B">
            <Grid x:Name="GridImageContainer" 
                  ClipToBounds="True"
                  Background="Transparent"
                  SizeChanged="GridImageContainer_SizeChanged"
                  MouseWheel="GridImageContainer_MouseWheel"
                  MouseDown="GridImageContainer_MouseDown"
                  MouseMove="GridImageContainer_MouseMove"
                  MouseUp="GridImageContainer_MouseUp">
                
                <!-- Viewport chứa ảnh và Canvas ROI cùng hệ tọa độ pixel -->
                <Canvas x:Name="ViewportCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ViewportScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="ViewportTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <Image x:Name="ImageScreen" Stretch="Fill" />
                    <Canvas x:Name="CanvasRoi"
                            Background="Transparent"
                            MouseDown="CanvasRoi_MouseDown"
                            MouseMove="CanvasRoi_MouseMove"
                            MouseUp="CanvasRoi_MouseUp"/>
                </Canvas>

                <!-- Hiển thị % Zoom hiện tại -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="10" Background="#90000000" CornerRadius="3" Padding="6,2"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="TxtZoomLevel" Text="100%" Foreground="White" FontSize="11"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
