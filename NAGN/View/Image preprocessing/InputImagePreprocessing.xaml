<Window x:Class="NAGN.View.Image_preprocessing.InputImagePreprocessing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NAGN.View.Image_preprocessing"
        mc:Ignorable="d"
        Title="Thêm bước tiền xử lý ảnh" 
        Height="250" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2D2D30">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Chọn thuật toán xử lý ảnh:" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
            <Button x:Name="Threshold"
                    Background="#3E3E42" Foreground="White" BorderBrush="#555"
                    Padding="10,8" Margin="0,5" FontSize="14"
                    Click="Button_Click_Choose_Image_Preprocessing">
                <TextBlock Text="Threshold (Phân ngưỡng nhị phân)" />
            </Button>
            <Button x:Name="Blur"
                    Background="#3E3E42" Foreground="White" BorderBrush="#555"
                    Padding="10,8" Margin="0,5" FontSize="14"
                    Click="Button_Click_Choose_Image_Preprocessing">
                <TextBlock Text="Blur (Bộ lọc làm mịn / Median)" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
