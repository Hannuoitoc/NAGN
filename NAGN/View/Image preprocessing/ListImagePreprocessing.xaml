<UserControl x:Class="NAGN.View.Image_preprocessing.ListImagePreprocessing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NAGN.View.Image_preprocessing"
             xmlns:model="clr-namespace:NAGN.Model"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type model:Threshold}">
            <local:ImagePreprocessing OnImagePreprocessSetting="ImagePreprocessing_OnImagePreprocessSetting"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type model:Blur}">
            <local:ImagePreprocessing OnImagePreprocessSetting="ImagePreprocessing_OnImagePreprocessSetting" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding}" />
        </ScrollViewer>
    </Grid>
</UserControl>
