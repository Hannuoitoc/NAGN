<UserControl x:Class="NAGN.View.Image_preprocessing.BlurView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NAGN.View.Image_preprocessing"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Blur" />
            <TextBlock Text="   Ksize" />
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

                <Slider x:Name="KsizeMinSlider"
                        Minimum="1"
                        Maximum="21"
                        TickFrequency="2"
                        IsSnapToTickEnabled="True"
                        Value="{Binding Ksize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center"
                        Grid.Column="0"
                        ValueChanged="ValueChanged"
                        PreviewMouseLeftButtonUp="KsizeMinSlider_PreviewMouseLeftButtonUp" />
                <TextBox Text="{Binding Value, ElementName=KsizeMinSlider, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat='{}{0:F0}'}"
                     Width="Auto"
                     HorizontalAlignment="Right"
                     Grid.Column="1" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
