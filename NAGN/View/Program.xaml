<UserControl x:Class="NAGN.UsersControllers.Program"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:model="clr-namespace:NAGN.Model"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type model:Algorithms}">
            <TextBlock Text="{Binding Name}"
                       Foreground="Black" />
        </DataTemplate>
        
        <HierarchicalDataTemplate DataType="{x:Type model:FOV}"
                                  ItemsSource="{Binding Algorithmslist}">
            <TextBlock Text="{Binding Name}"
                       FontWeight="Bold"
                       Foreground="Black"/>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type model:Program}"
                                  ItemsSource="{Binding FOVlist}">
            <TextBlock Text="{Binding Name}"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="Black" />
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        
        <TreeView x:Name="TreeViewProgram"
                   Background="Gray"
                  SelectedItemChanged="TreeViewProgram_SelectedItemChanged" />
    </Grid>
</UserControl>
